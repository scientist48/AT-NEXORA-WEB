# ── Build-time (Cloudflare Pages → Settings → Variables and Secrets, or local .env) ──
# Public URL of the deployed site, no trailing slash. Used for canonical URLs,
# Open Graph, sitemap and robots.txt. Example: https://<your-project>.pages.dev
SITE_URL=

# ── Runtime, server-side only (Cloudflare Pages Functions) ──
# For local testing with `npm run preview:cf`, copy these into `.dev.vars`
# (git-ignored). Never commit real values and never prefix them with PUBLIC_.

# Admin dashboard login (/admin/). Store both as encrypted Secrets.
# ADMIN_PASSWORD_HASH is generated with `npm run admin:hash` — never store the plain password.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# Optional: comma-separated extra origins allowed to POST to /api/contact
# (the site's own origin is always allowed).
# CONTACT_ALLOWED_ORIGINS=

# The D1 database is configured as the `DB` binding in wrangler.toml, not here.
