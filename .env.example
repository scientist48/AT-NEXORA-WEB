# ── Build-time (Cloudflare Pages → Settings → Variables and Secrets, or local .env) ──
# Public URL of the deployed site, no trailing slash. Used for canonical URLs,
# Open Graph, sitemap and robots.txt. Example: https://<your-project>.pages.dev
SITE_URL=

# ── Runtime, server-side only (Cloudflare Pages Functions) ──
# For local testing with `npm run preview:cf`, copy these into a `.dev.vars` file.
# Never commit real values and never prefix them with PUBLIC_.

# Resend API key (https://resend.com/api-keys). Set as an encrypted *Secret*.
RESEND_API_KEY=

# Sender address on a domain you have verified in Resend,
# e.g. "AT NEXORA Website <website@your-verified-domain.com>".
CONTACT_FROM_EMAIL=

# Optional: comma-separated extra origins allowed to POST to /api/contact
# (the site's own origin is always allowed).
# CONTACT_ALLOWED_ORIGINS=
