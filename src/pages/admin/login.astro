---
import AdminLayout from '../../layouts/AdminLayout.astro';
const field =
  'mt-2 block w-full rounded-[0.625rem] border border-navy/25 bg-paper px-4 py-3.5 text-base text-ink transition-colors hover:border-navy/50 focus:border-navy focus:outline-none focus:ring-2 focus:ring-navy/20';
---
<AdminLayout title="Sign in">
  <a slot="header-actions" href="/" class="text-sm font-medium text-navy underline-offset-4 hover:underline">Back to website</a>
  <section class="shell grid min-h-[calc(100dvh-4rem)] place-items-center py-12">
    <div class="w-full max-w-md">
      <p class="eyebrow text-navy">Private area</p>
      <h1 class="t-d3 mt-4 text-navy">Sign in to the inquiry dashboard</h1>
      <p class="mt-3 text-ink-soft">For AT NEXORA Technologies staff only.</p>

      <form id="login-form" class="mt-8 grid gap-5 rounded-[var(--radius-panel)] border border-silver bg-paper p-6 sm:p-8" novalidate>
        <div>
          <label for="username" class="block text-[0.9375rem] font-medium text-navy">Username</label>
          <input id="username" name="username" type="text" autocomplete="username" autocapitalize="none" spellcheck="false" required maxlength="100" class={field} />
        </div>
        <div>
          <label for="password" class="block text-[0.9375rem] font-medium text-navy">Password</label>
          <input id="password" name="password" type="password" autocomplete="current-password" required maxlength="256" class={field} />
        </div>
        <p id="login-error" role="alert" class="hidden rounded-[0.625rem] border border-danger/30 bg-danger/5 px-4 py-3 text-sm font-medium text-danger"></p>
        <button type="submit" class="btn btn-primary w-full" data-submit>
          <span data-label>Sign in</span>
        </button>
      </form>
      <p class="mt-6 text-sm text-ink-soft">Sessions end after one hour of inactivity or eight hours in total.</p>
    </div>
  </section>
</AdminLayout>

<script>
  const form = document.getElementById('login-form') as HTMLFormElement;
  const error = document.getElementById('login-error')!;
  const button = form.querySelector<HTMLButtonElement>('[data-submit]')!;
  const label = form.querySelector<HTMLElement>('[data-label]')!;
  let busy = false;

  const showError = (message: string) => {
    error.textContent = message;
    error.classList.remove('hidden');
  };

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (busy) return;
    const username = (form.elements.namedItem('username') as HTMLInputElement).value.trim();
    const password = (form.elements.namedItem('password') as HTMLInputElement).value;
    if (!username || !password) {
      showError('Enter your username and password.');
      return;
    }
    busy = true;
    button.disabled = true;
    label.textContent = 'Signing in…';
    error.classList.add('hidden');
    try {
      const res = await fetch('/api/admin/login', {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({ username, password }),
      });
      const data = await res.json().catch(() => ({}));
      if (res.ok && data.ok) {
        window.location.replace('/admin/');
        return;
      }
      (form.elements.namedItem('password') as HTMLInputElement).value = '';
      showError(data.message ?? 'Sign-in failed. Please try again.');
    } catch {
      showError('Could not reach the server. Check your connection and try again.');
    } finally {
      busy = false;
      button.disabled = false;
      label.textContent = 'Sign in';
    }
  });
</script>
