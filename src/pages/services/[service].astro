---
import { ArrowUpRight, Check } from '@lucide/astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBand from '../../components/ui/CtaBand.astro';
import FaqList from '../../components/ui/FaqList.astro';
import ProjectCard from '../../components/ui/ProjectCard.astro';
import Mockup from '../../components/mockups/Mockup.astro';
import { services, type Service } from '../../content/services';
import { projectsByCategory } from '../../content/projects';

export function getStaticPaths() {
  return services.map((service) => ({ params: { service: service.slug }, props: { service } }));
}
interface Props { service: Service }
const { service: s } = Astro.props;
const demos = projectsByCategory(s.slug);
const others = services.filter((o) => o.slug !== s.slug);
const site = Astro.site ?? new URL('http://localhost:4321');

const hero = {
  navy: { panel: 'on-dark bg-navy text-pearl', title: 'text-pearl', sub: 'text-navy-mist', eyebrow: 'text-lime', crumb: 'text-navy-mist hover:text-pearl', primary: 'btn-lime', ghost: 'btn-ghost-dark' },
  ice: { panel: 'bg-ice text-ink', title: 'text-navy', sub: 'text-ink-soft', eyebrow: 'text-navy', crumb: 'text-ink-soft hover:text-navy', primary: 'btn-primary', ghost: 'btn-ghost' },
  paper: { panel: 'bg-paper text-ink ring-1 ring-inset ring-silver', title: 'text-navy', sub: 'text-ink-soft', eyebrow: 'text-navy', crumb: 'text-ink-soft hover:text-navy', primary: 'btn-primary', ghost: 'btn-ghost' },
}[s.theme];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: s.name,
    description: s.summary,
    serviceType: s.name,
    provider: { '@type': 'Organization', name: 'AT NEXORA Technologies', url: site.href },
    url: new URL(`/services/${s.slug}/`, site).href,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: s.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site.href },
      { '@type': 'ListItem', position: 2, name: 'Services', item: new URL('/services/', site).href },
      { '@type': 'ListItem', position: 3, name: s.name, item: new URL(`/services/${s.slug}/`, site).href },
    ],
  },
];
---
<BaseLayout title={s.seo.title} description={s.seo.description} jsonLd={jsonLd}>
  <section class="pt-[4.5rem]">
    <div class="shell pt-4 md:pt-6">
      <div class:list={['overflow-hidden rounded-[var(--radius-panel)]', hero.panel]}>
        <div class="grid items-center lg:grid-cols-12">
          <div class="p-6 pb-8 sm:p-10 lg:col-span-6 lg:p-14 xl:p-16">
            <nav aria-label="Breadcrumb">
              <ol class="eyebrow flex flex-wrap items-center gap-x-3 gap-y-1">
                <li class="flex items-center gap-3"><a href="/" class:list={['inline-flex min-h-8 items-center', hero.crumb]}>Home</a><span aria-hidden="true" class={hero.sub}>/</span></li>
                <li class="flex items-center gap-3"><a href="/services/" class:list={['inline-flex min-h-8 items-center', hero.crumb]}>Services</a><span aria-hidden="true" class={hero.sub}>/</span></li>
                <li aria-current="page" class={hero.eyebrow}>{s.index} {s.name}</li>
              </ol>
            </nav>
            <h1 class:list={['t-d1 mt-8', hero.title]}>{s.hero.title}</h1>
            <p class:list={['t-lead mt-6 max-w-xl', hero.sub]}>{s.hero.intro}</p>
            <div class="mt-9 flex flex-col gap-3 sm:flex-row">
              <a href={`/contact/?service=${encodeURIComponent(s.name)}`} class:list={['btn', hero.primary]}>Start a Project <ArrowUpRight aria-hidden="true" /></a>
              <a href="#capabilities" class:list={['btn', hero.ghost]}>View capabilities</a>
            </div>
          </div>
          <div class="p-6 pt-0 sm:p-10 sm:pt-0 lg:col-span-6 lg:p-14 lg:pl-0">
            <Mockup kind={s.mockup} label={`Illustrative ${s.name} interface`} class="shadow-[0_40px_80px_-40px_rgba(16,24,39,0.6)]" />
            <p class:list={['eyebrow mt-4', hero.sub]}>Illustrative interface · sample data</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Overview -->
  <section class="section" aria-labelledby="overview-title">
    <div class="shell grid gap-10 lg:grid-cols-12 lg:gap-8">
      <h2 id="overview-title" class="eyebrow text-navy lg:col-span-3 lg:pt-3">Overview</h2>
      <div class="lg:col-span-9">
        <p class="t-d3 text-navy" data-reveal>{s.overview[0]}</p>
        <p class="t-lead mt-8 max-w-3xl text-ink-soft" data-reveal>{s.overview[1]}</p>
      </div>
    </div>
  </section>

  <!-- Problems -->
  <section class="section-tight" aria-labelledby="problems-title">
    <div class="shell">
      <div class="grid gap-6 lg:grid-cols-12 lg:gap-8">
        <p class="eyebrow text-navy lg:col-span-3 lg:pt-3">Problems we address</p>
        <h2 id="problems-title" class="t-d2 text-navy lg:col-span-9">Sound familiar?</h2>
      </div>
      <ul class="mt-12 grid border-t border-silver sm:grid-cols-2 lg:grid-cols-4">
        {s.problems.map((p, i) => (
          <li class:list={['border-b border-silver py-8 sm:px-8 lg:border-b-0 lg:border-l lg:py-10', i === 0 && 'sm:pl-0 lg:border-l-0', i === 2 && 'sm:pl-0 lg:pl-8', i % 2 === 1 && 'sm:border-l']} data-reveal style={`--reveal-i:${i}`}>
            <p class="eyebrow text-ink-soft">0{i + 1}</p>
            <h3 class="mt-5 font-display text-[1.375rem] font-semibold leading-tight tracking-[-0.025em] text-navy">{p.title}</h3>
            <p class="mt-3 leading-relaxed text-ink-soft">{p.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Business value -->
  <section class="section-tight" aria-labelledby="value-title">
    <div class="shell">
      <div class="on-dark rounded-[var(--radius-panel)] bg-navy p-6 text-pearl sm:p-10 lg:p-16">
        <p class="eyebrow text-lime">Business value</p>
        <h2 id="value-title" class="t-d2 mt-6 max-w-[22ch]">{s.value}</h2>
        <ul class="mt-12 grid gap-8 border-t border-navy-line pt-10 md:grid-cols-3 md:gap-10">
          {s.outcomes.map((o, i) => (
            <li data-reveal style={`--reveal-i:${i}`}>
              <span class="block h-2.5 w-2.5 rounded-[2px] bg-lime" aria-hidden="true"></span>
              <h3 class="mt-5 font-display text-[1.375rem] font-semibold leading-tight tracking-[-0.025em]">{o.title}</h3>
              <p class="mt-3 leading-relaxed text-navy-mist">{o.text}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Capabilities -->
  <section id="capabilities" class="section" aria-labelledby="capabilities-title">
    <div class="shell">
      <div class="grid gap-6 lg:grid-cols-12 lg:gap-8">
        <p class="eyebrow text-navy lg:col-span-3 lg:pt-3">Capabilities</p>
        <h2 id="capabilities-title" class="t-d2 text-navy lg:col-span-9">What we deliver in {s.name}.</h2>
      </div>
      <ul class="mt-12 border-t border-navy/15 md:mt-16">
        {s.capabilities.map((c, i) => (
          <li class="grid gap-5 border-b border-navy/15 py-8 lg:grid-cols-12 lg:gap-8 lg:py-10" data-reveal>
            <p class="eyebrow text-ink-soft lg:col-span-1 lg:pt-2">0{i + 1}</p>
            <div class="lg:col-span-5">
              <h3 class="font-display text-[1.75rem] font-semibold leading-[1.05] tracking-[-0.03em] text-navy md:text-[2.125rem]">{c.title}</h3>
              <p class="mt-3 max-w-md leading-relaxed text-ink-soft">{c.text}</p>
            </div>
            <ul class="grid content-start gap-x-8 sm:grid-cols-2 lg:col-span-6">
              {c.items.map((item) => (
                <li class="flex items-start gap-3 border-b border-silver py-3 text-[0.9375rem] text-ink">
                  <span class="mt-[0.5rem] h-1.5 w-1.5 flex-none rounded-[1px] bg-navy" aria-hidden="true"></span>
                  {item}
                </li>
              ))}
            </ul>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Deliverables + technology -->
  <section class="section-tight" aria-label="Deliverables and technology">
    <div class="shell grid gap-5 md:gap-6 lg:grid-cols-12">
      <div class="rounded-[var(--radius-panel)] bg-ice p-6 sm:p-10 lg:col-span-5 lg:p-12" data-reveal>
        <p class="eyebrow text-navy">Deliverables</p>
        <h2 class="t-d3 mt-5 text-navy">What you receive.</h2>
        <ul class="mt-8 grid gap-0 border-t border-navy/15">
          {s.deliverables.map((d) => (
            <li class="flex items-start gap-3.5 border-b border-navy/15 py-3.5 text-ink">
              <span class="mt-0.5 grid h-5 w-5 flex-none place-items-center rounded-full bg-navy text-lime"><Check class="h-3 w-3" stroke-width={3} aria-hidden="true" /></span>
              {d}
            </li>
          ))}
        </ul>
      </div>
      <div class="rounded-[var(--radius-panel)] bg-paper p-6 ring-1 ring-inset ring-silver sm:p-10 lg:col-span-7 lg:p-12" data-reveal style="--reveal-i:1">
        <p class="eyebrow text-navy">Technology expertise</p>
        <h2 class="t-d3 mt-5 text-navy">Tools we work with.</h2>
        <dl class="mt-8 grid gap-x-10 gap-y-7 sm:grid-cols-2">
          {s.technologies.map((t) => (
            <div>
              <dt class="eyebrow border-b border-silver pb-3 text-ink-soft">{t.group}</dt>
              <dd class="mt-3 flex flex-wrap gap-1.5">
                {t.items.map((item) => (
                  <span class="rounded-full bg-pearl px-3 py-1.5 text-sm text-navy ring-1 ring-inset ring-silver">{item}</span>
                ))}
              </dd>
            </div>
          ))}
        </dl>
        <p class="mt-8 text-sm text-ink-soft">We select tools to suit each project and are comfortable working within your existing stack.</p>
      </div>
    </div>
  </section>

  <!-- Methodology -->
  <section class="section" aria-labelledby="method-title">
    <div class="shell">
      <div class="grid gap-6 lg:grid-cols-12 lg:gap-8">
        <p class="eyebrow text-navy lg:col-span-3 lg:pt-3">Methodology</p>
        <div class="lg:col-span-9">
          <h2 id="method-title" class="t-d2 text-navy">How a {s.name} engagement runs.</h2>
          <p class="mt-5 text-ink-soft">This is our seven-stage <a href="/process/" class="link text-navy">engineering process</a>, tailored to this discipline.</p>
        </div>
      </div>
      <ol class="method mt-12 grid gap-0 border-t border-navy/15 md:mt-16 md:grid-cols-5 md:border-t-0">
        {s.methodology.map((m, i) => (
          <li class="relative border-b border-navy/15 py-7 md:border-b-0 md:border-t md:pr-6 md:pt-8" data-reveal style={`--reveal-i:${i}`}>
            <span class="absolute -top-[0.3125rem] left-0 hidden h-2.5 w-2.5 rounded-[2px] border-[1.5px] border-navy bg-lime md:block" aria-hidden="true"></span>
            <p class="eyebrow text-ink-soft">Step 0{i + 1}</p>
            <h3 class="mt-3 font-display text-[1.5rem] font-semibold leading-tight tracking-[-0.025em] text-navy">{m.title}</h3>
            <p class="mt-2.5 text-[0.9375rem] leading-relaxed text-ink-soft">{m.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Demonstrations -->
  {demos.length > 0 && (
    <section class="section-tight" aria-labelledby="demos-title">
      <div class="shell">
        <div class="grid gap-6 lg:grid-cols-12 lg:gap-8">
          <p class="eyebrow text-navy lg:col-span-3 lg:pt-3">Demonstrations</p>
          <div class="lg:col-span-9">
            <h2 id="demos-title" class="t-d2 text-navy">See the thinking in practice.</h2>
            <p class="mt-5 max-w-2xl text-ink-soft">Concept demonstrations, not client projects. Each shows how we would approach a typical {s.name} problem.</p>
          </div>
        </div>
        <div class="mt-12 grid gap-x-8 gap-y-14 md:grid-cols-2">
          {demos.map((p) => <div data-reveal><ProjectCard project={p} /></div>)}
        </div>
      </div>
    </section>
  )}

  <!-- FAQs -->
  <section class="section" aria-labelledby="faq-title">
    <div class="shell grid gap-10 lg:grid-cols-12 lg:gap-8">
      <div class="lg:col-span-4">
        <p class="eyebrow text-navy">FAQ</p>
        <h2 id="faq-title" class="t-d2 mt-6 text-navy">Questions about {s.name}.</h2>
        <a href="/faq/" class="link mt-6 inline-block font-medium text-navy">All frequently asked questions</a>
      </div>
      <div class="lg:col-span-8"><FaqList items={s.faqs} /></div>
    </div>
  </section>

  <!-- Other services -->
  <section class="section-tight" aria-label="Other services">
    <div class="shell">
      <p class="eyebrow text-navy">Related services</p>
      <ul class="mt-6 grid border-t border-navy/15 md:grid-cols-2">
        {others.map((o, i) => (
          <li class:list={['border-b border-navy/15', i === 1 && 'md:border-l']}>
            <a href={`/services/${o.slug}/`} class:list={['group flex items-center justify-between gap-6 py-8', i === 1 && 'md:pl-8', i === 0 && 'md:pr-8']}>
              <span>
                <span class="eyebrow text-ink-soft">{o.index}</span>
                <span class="mt-2 block font-display text-[1.875rem] font-semibold leading-none tracking-[-0.03em] text-navy md:text-[2.5rem]">{o.name}</span>
              </span>
              <span class="grid h-12 w-12 flex-none place-items-center rounded-full border border-navy/20 text-navy transition-colors duration-300 group-hover:bg-navy group-hover:text-pearl">
                <ArrowUpRight class="h-4 w-4" aria-hidden="true" />
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CtaBand title={`Ready to talk about ${s.name}?`} />
</BaseLayout>
