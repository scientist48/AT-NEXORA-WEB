---
import { ArrowUpRight } from '@lucide/astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import CtaBand from '../../components/ui/CtaBand.astro';
import SectionHead from '../../components/ui/SectionHead.astro';
import Mockup from '../../components/mockups/Mockup.astro';
import EcosystemViz from '../../components/three/EcosystemViz.tsx';
import { services } from '../../content/services';
import { ecosystemLayers } from '../../content/ecosystem';

const engagement = [
  { title: 'A defined project', text: 'A clear scope delivered in agreed phases. Suited to a new product, platform, dashboard suite or automation.' },
  { title: 'Ongoing partnership', text: 'Continuous development and improvement of systems that are already live.' },
  { title: 'Focused assessment', text: 'A short review of an existing system, data estate or process, ending in practical recommendations.' },
];
---
<BaseLayout
  title="Services"
  description="Digital Engineering, Data Intelligence and AI & Automation. Explore how AT NEXORA Technologies builds custom software, business intelligence and AI-powered systems."
>
  <PageHero
    eyebrow="Services"
    crumbs={[{ label: 'Home', href: '/' }]}
    title="Engineering across <span class='mark'>software, data and AI.</span>"
    intro="Three specialist divisions, working as one team, so the systems we deliver fit together from the start."
  />

  <section class="section-tight" aria-label="Service divisions">
    <div class="shell">
      <ul class="border-t border-navy/15">
        {services.map((s) => (
          <li class="border-b border-navy/15 py-10 md:py-16" data-reveal>
            <article class="grid gap-8 lg:grid-cols-12 lg:gap-8">
              <div class="lg:col-span-6">
                <p class="eyebrow text-ink-soft">{s.index}</p>
                <h2 class="t-d1 mt-4 text-navy">
                  <a href={`/services/${s.slug}/`} class="hover:underline hover:decoration-lime hover:decoration-[0.12em] hover:underline-offset-[0.12em]">{s.name}</a>
                </h2>
                <p class="t-lead mt-6 max-w-xl text-ink-soft">{s.summary}</p>
                <ul class="mt-8 flex flex-wrap gap-2" aria-label={`${s.name} services`}>
                  {s.highlights.map((h) => (
                    <li class="rounded-full border border-navy/20 px-3.5 py-1.5 text-sm text-navy">{h}</li>
                  ))}
                </ul>
                <a href={`/services/${s.slug}/`} class="btn btn-primary mt-10">
                  Explore {s.name} <ArrowUpRight aria-hidden="true" />
                </a>
              </div>
              <a href={`/services/${s.slug}/`} tabindex="-1" aria-hidden="true" class:list={['block rounded-[var(--radius-panel)] p-5 sm:p-8 lg:col-span-6', { navy: 'bg-navy', ice: 'bg-ice', paper: 'bg-paper ring-1 ring-inset ring-silver' }[s.theme]]}>
                <Mockup kind={s.mockup} label={`Illustrative ${s.name} interface`} class="shadow-[0_30px_60px_-30px_rgba(16,24,39,0.5)]" />
              </a>
            </article>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" aria-label="How the services connect">
    <div class="shell">
      <SectionHead
        eyebrow="Better together"
        title="Each service strengthens the others."
        intro="You can engage a single division. The real advantage appears when software, data and AI are designed as one system."
      />
      <div class="mt-12 md:mt-20">
        <EcosystemViz client:visible={{ rootMargin: '300px' }} layers={ecosystemLayers} poster="/posters/ecosystem.webp" />
      </div>
    </div>
  </section>

  <section class="section-tight" aria-labelledby="engage-title">
    <div class="shell grid gap-10 lg:grid-cols-12 lg:gap-8">
      <div class="lg:col-span-4">
        <p class="eyebrow text-navy">Ways to engage</p>
        <h2 id="engage-title" class="t-d2 mt-6 text-navy">Start where it makes sense.</h2>
      </div>
      <ul class="border-t border-silver lg:col-span-7 lg:col-start-6">
        {engagement.map((e, i) => (
          <li class="grid gap-2 border-b border-silver py-7 sm:grid-cols-[3rem_1fr]" data-reveal>
            <span class="eyebrow pt-1.5 text-ink-soft" aria-hidden="true">0{i + 1}</span>
            <div>
              <h3 class="font-display text-[1.5rem] font-semibold leading-tight tracking-[-0.025em] text-navy">{e.title}</h3>
              <p class="mt-2 leading-relaxed text-ink-soft">{e.text}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CtaBand title="Not sure which service you need? Start with the problem." text="Describe what you are trying to achieve and we will suggest the right combination of engineering, data and AI." />
</BaseLayout>
