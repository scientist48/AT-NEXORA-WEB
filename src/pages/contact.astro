---
import { ArrowUpRight, Mail, Phone, MessageCircle } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/ui/PageHero.astro';
import ContactForm from '../components/ui/ContactForm.astro';
import { company } from '../content/site';

const next = [
  { title: 'We read it properly', text: 'Your enquiry goes to the team, not to an automated queue.' },
  { title: 'We reply with questions or a call', text: 'Usually a short conversation to understand goals, constraints and timing.' },
  { title: 'You receive a proposal', text: 'A written scope, approach and estimate you can evaluate without pressure.' },
];
const site = Astro.site ?? new URL('http://localhost:4321');
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ContactPage',
    name: 'Contact AT NEXORA Technologies',
    url: new URL('/contact/', site).href,
  },
];
---
<BaseLayout
  title="Contact"
  description="Start a project with AT NEXORA Technologies. Send a project enquiry, email atnexoratechnologies@gmail.com, call +92 347 5503548 or message us on WhatsApp."
  jsonLd={jsonLd}
>
  <PageHero
    eyebrow="Contact"
    crumbs={[{ label: 'Home', href: '/' }]}
    title="Tell us what you’re <span class='mark'>building.</span>"
    intro="Share a few details and we will come back with clear next steps."
  />

  <section class="pb-16 md:pb-28" aria-label="Contact options">
    <div class="shell grid gap-12 border-t border-silver pt-10 lg:grid-cols-12 lg:gap-8 lg:pt-16">
      <div class="lg:col-span-7">
        <h2 class="t-d3 text-navy">Project enquiry</h2>
        <div class="mt-8"><ContactForm /></div>
      </div>

      <aside class="lg:col-span-4 lg:col-start-9" aria-label="Direct contact details">
        <div class="on-dark rounded-[var(--radius-panel)] bg-navy p-6 text-pearl sm:p-8">
          <h2 class="eyebrow text-lime">Contact us directly</h2>
          <ul class="mt-6 border-t border-navy-line">
            <li class="border-b border-navy-line">
              <a href={company.emailHref} class="group flex min-h-[4.75rem] items-center gap-4 py-4">
                <span class="grid h-11 w-11 flex-none place-items-center rounded-full border border-navy-line"><Mail class="h-4 w-4" aria-hidden="true" /></span>
                <span class="min-w-0">
                  <span class="eyebrow block text-navy-mist">Email</span>
                  <span class="mt-0.5 block break-all font-medium group-hover:text-lime">{company.email}</span>
                </span>
              </a>
            </li>
            <li class="border-b border-navy-line">
              <a href={company.phoneHref} class="group flex min-h-[4.75rem] items-center gap-4 py-4">
                <span class="grid h-11 w-11 flex-none place-items-center rounded-full border border-navy-line"><Phone class="h-4 w-4" aria-hidden="true" /></span>
                <span>
                  <span class="eyebrow block text-navy-mist">Phone</span>
                  <span class="mt-0.5 block font-medium group-hover:text-lime">{company.phoneDisplay}</span>
                </span>
              </a>
            </li>
            <li class="border-b border-navy-line">
              <a href={company.whatsappHref} target="_blank" rel="noopener noreferrer" class="group flex min-h-[4.75rem] items-center gap-4 py-4">
                <span class="grid h-11 w-11 flex-none place-items-center rounded-full border border-navy-line"><MessageCircle class="h-4 w-4" aria-hidden="true" /></span>
                <span class="flex-1">
                  <span class="eyebrow block text-navy-mist">WhatsApp</span>
                  <span class="mt-0.5 block font-medium group-hover:text-lime">Start a chat<span class="sr-only"> (opens in a new tab)</span></span>
                </span>
                <ArrowUpRight class="h-4 w-4 text-navy-mist" aria-hidden="true" />
              </a>
            </li>
          </ul>
          <p class="mt-6 text-sm leading-relaxed text-navy-mist">We work with clients remotely across time zones. Tell us your location and we will arrange a suitable time to talk.</p>
        </div>

        <div class="mt-10">
          <h2 class="eyebrow text-navy">What happens next</h2>
          <ol class="mt-5 border-t border-silver">
            {next.map((n, i) => (
              <li class="grid grid-cols-[2.5rem_1fr] gap-2 border-b border-silver py-5">
                <span class="eyebrow pt-1 text-ink-soft" aria-hidden="true">0{i + 1}</span>
                <div>
                  <h3 class="font-display text-xl font-semibold tracking-[-0.02em] text-navy">{n.title}</h3>
                  <p class="mt-1.5 text-[0.9375rem] leading-relaxed text-ink-soft">{n.text}</p>
                </div>
              </li>
            ))}
          </ol>
          <p class="mt-6 text-sm text-ink-soft">Have a general question first? See the <a href="/faq/" class="font-medium text-navy underline underline-offset-4">FAQ</a>.</p>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
