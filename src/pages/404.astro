---
import { ArrowUpRight } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
const links = [
  { label: 'Services', href: '/services/' },
  { label: 'Portfolio', href: '/portfolio/' },
  { label: 'Our Process', href: '/process/' },
  { label: 'Contact', href: '/contact/' },
];
---
<BaseLayout title="Page not found" description="The page you were looking for could not be found." noindex>
  <section class="pt-[4.5rem]">
    <div class="shell grid min-h-[calc(100svh-4.5rem)] content-center gap-10 py-16 lg:grid-cols-12 lg:gap-8">
      <div class="lg:col-span-7">
        <p class="eyebrow text-navy">Error 404</p>
        <p class="nf mt-4 font-display font-bold leading-[0.8] tracking-[-0.06em] text-navy" aria-hidden="true">4<span class="nf-zero">0</span>4</p>
        <h1 class="t-d2 mt-8 text-navy">This page isn’t part of the system.</h1>
        <p class="t-lead mt-5 max-w-lg text-ink-soft">The link may be out of date, or the page may have moved. Let’s get you back on track.</p>
        <a href="/" class="btn btn-primary mt-9">Back to home <ArrowUpRight aria-hidden="true" /></a>
      </div>
      <nav aria-label="Helpful links" class="self-end lg:col-span-4 lg:col-start-9">
        <p class="eyebrow text-ink-soft">Or go to</p>
        <ul class="mt-4 border-t border-navy/15">
          {links.map((l) => (
            <li class="border-b border-navy/15">
              <a href={l.href} class="group flex min-h-[3.75rem] items-center justify-between font-display text-2xl font-semibold tracking-[-0.025em] text-navy">
                {l.label}
                <ArrowUpRight class="h-5 w-5 transition-transform duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5" aria-hidden="true" />
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </section>
</BaseLayout>

<style>
  .nf { font-size: clamp(7rem, 3rem + 22vw, 20rem); }
  .nf-zero { background: linear-gradient(var(--color-lime), var(--color-lime)) no-repeat 50% 62% / 100% 0.22em; }
</style>
