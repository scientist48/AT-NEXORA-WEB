---
import { ArrowUpRight } from '@lucide/astro';
import SectionHead from '../ui/SectionHead.astro';
import ProjectCard from '../ui/ProjectCard.astro';
import { featuredProjects } from '../../content/projects';
const spans = ['lg:col-span-7', 'lg:col-span-5 lg:mt-24', 'lg:col-span-5', 'lg:col-span-7 lg:mt-24'];
---
<section class="section" aria-label="Selected work">
  <div class="shell">
    <SectionHead
      eyebrow="Selected work"
      title="Concept work that shows how we think."
      intro="These are self-initiated concept demonstrations, not client projects. Each one shows how we would approach a common business problem."
    />
    <div class="mt-12 grid gap-x-6 gap-y-14 md:mt-20 lg:grid-cols-12 lg:gap-x-8">
      {featuredProjects.slice(0, 4).map((p, i) => (
        <div class={spans[i]} data-reveal>
          <ProjectCard project={p} />
        </div>
      ))}
    </div>
    <div class="mt-14 flex justify-center md:mt-20">
      <a href="/portfolio/" class="btn btn-ghost">View all work <ArrowUpRight aria-hidden="true" /></a>
    </div>
  </div>
</section>
