---
import { ArrowUpRight } from '@lucide/astro';
import SectionHead from '../ui/SectionHead.astro';
import { processSteps } from '../../content/process';
---
<section class="on-dark section bg-navy text-pearl" aria-label="Engineering approach">
  <div class="shell">
    <SectionHead
      tone="dark"
      eyebrow="Engineering approach"
      title="Seven stages. No surprises."
      intro="A consistent path from first conversation to continuous improvement, with something concrete to review at every stage."
    />

    <ol class="approach mt-14 md:mt-20">
      {processSteps.map((step, i) => (
        <li class="approach-step" data-reveal style={`--reveal-i:${i % 4}`}>
          <span class="approach-node" aria-hidden="true"></span>
          <p class="eyebrow text-lime">{step.index}</p>
          <h3 class="mt-3 font-display text-[1.625rem] font-semibold leading-none tracking-[-0.03em] xl:text-[1.5rem] 2xl:text-[1.625rem]">{step.name}</h3>
          <p class="mt-3 text-[0.9375rem] leading-relaxed text-navy-mist">{step.summary}</p>
          <p class="mt-4 text-sm text-pearl">
            <span class="eyebrow block text-navy-mist">Output</span>
            {step.output}
          </p>
        </li>
      ))}
    </ol>

    <div class="mt-14 md:mt-20">
      <a href="/process/" class="btn btn-ghost-dark">See the full process <ArrowUpRight aria-hidden="true" /></a>
    </div>
  </div>
</section>

<style>
  /* Mobile / tablet: vertical timeline */
  .approach { position: relative; display: grid; gap: 2.25rem; padding-left: 2rem; }
  .approach::before {
    content: '';
    position: absolute;
    left: 0.3125rem;
    top: 0.4rem;
    bottom: 0.4rem;
    width: 1px;
    background: var(--color-navy-line);
  }
  .approach-step { position: relative; max-width: 34rem; }
  .approach-node {
    position: absolute;
    left: -2rem;
    top: 0.2rem;
    width: 0.6875rem;
    height: 0.6875rem;
    border-radius: 2px;
    background: var(--color-navy);
    border: 1.5px solid var(--color-lime);
  }
  .approach-step:first-child .approach-node { background: var(--color-lime); }

  @media (min-width: 48rem) and (max-width: 79.99rem) {
    .approach { grid-template-columns: 1fr 1fr; column-gap: 4rem; padding-left: 0; }
    .approach::before { display: none; }
    .approach-step { padding-left: 2rem; border-left: 1px solid var(--color-navy-line); }
    .approach-node { left: -0.375rem; }
  }

  /* Desktop: horizontal track */
  @media (min-width: 80rem) {
    .approach { grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 1.5rem; padding-left: 0; padding-top: 2.5rem; }
    .approach::before { left: 0; right: 0; top: 0.3125rem; bottom: auto; width: auto; height: 1px; }
    .approach-node { left: 0; top: -2.5rem; }
  }
</style>
