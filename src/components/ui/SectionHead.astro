---
interface Props {
  eyebrow: string;
  title: string;
  intro?: string;
  tone?: 'light' | 'dark';
  as?: 'h1' | 'h2';
  class?: string;
}
const { eyebrow, title, intro, tone = 'light', as: Tag = 'h2', class: cls = '' } = Astro.props;
---
<div class:list={['grid gap-6 lg:grid-cols-12 lg:gap-8', cls]} data-reveal>
  <p class:list={['eyebrow lg:col-span-3 lg:pt-3', tone === 'dark' ? 'text-lime' : 'text-navy']}>{eyebrow}</p>
  <div class="lg:col-span-9">
    <Tag class:list={['t-d2 max-w-[18ch]', tone === 'dark' ? 'text-pearl' : 'text-navy']} set:html={title} />
    {intro && (
      <p class:list={['t-lead mt-6 max-w-2xl', tone === 'dark' ? 'text-navy-mist' : 'text-ink-soft']}>{intro}</p>
    )}
    <slot />
  </div>
</div>
