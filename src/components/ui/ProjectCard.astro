---
import { ArrowUpRight } from '@lucide/astro';
import Mockup from '../mockups/Mockup.astro';
import type { Project } from '../../content/projects';
interface Props { project: Project; class?: string; headingLevel?: 'h2' | 'h3' }
const { project, class: cls = '', headingLevel: H = 'h3' } = Astro.props;
const toneClass = { navy: 'bg-navy', ice: 'bg-ice', paper: 'bg-paper ring-1 ring-inset ring-silver' }[project.tone];
---
<article class:list={['project-card group relative flex flex-col', cls]} data-category={project.category}>
  <div class:list={['relative overflow-hidden rounded-[var(--radius-panel)] p-5 pt-16 sm:p-8 sm:pt-[4.5rem] md:p-10 md:pt-[4.5rem]', toneClass]}>
    <div class="transition-transform duration-700 ease-[var(--ease-out-expo)] group-hover:-translate-y-1.5 group-hover:scale-[1.015]">
      <Mockup kind={project.screens[0].kind} label={`${project.title} — ${project.screens[0].caption}`} class="shadow-[0_30px_60px_-30px_rgba(16,24,39,0.45)]" />
    </div>
    <span class="eyebrow absolute left-4 top-4 rounded-full bg-lime px-3 py-1.5 text-ink sm:left-5 sm:top-5">
      {project.kind === 'concept' ? 'Concept' : 'Client work'}
    </span>
  </div>
  <div class="mt-5 flex items-start justify-between gap-6">
    <div>
      <p class="eyebrow text-ink-soft">{project.categoryLabel} · {project.discipline}</p>
      <H class="mt-2.5 font-display text-[1.625rem] font-semibold leading-[1.08] tracking-[-0.03em] text-navy md:text-[2rem]">
        <a href={`/portfolio/${project.slug}/`} class="after:absolute after:inset-0 after:content-['']">{project.title}</a>
      </H>
      <p class="mt-3 max-w-xl text-ink-soft">{project.summary}</p>
    </div>
    <span aria-hidden="true" class="mt-1 grid h-11 w-11 flex-none place-items-center rounded-full border border-navy/20 text-navy transition-colors duration-300 group-hover:bg-navy group-hover:text-pearl">
      <ArrowUpRight class="h-4 w-4" />
    </span>
  </div>
</article>
