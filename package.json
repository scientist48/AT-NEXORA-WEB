{
  "name": "at-nexora-technologies",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Official website of AT NEXORA Technologies \u2014 digital engineering, data intelligence and AI automation.",
  "engines": {
    "node": ">=20.3.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "preview:cf": "wrangler pages dev dist --compatibility-date=2026-01-01",
    "check": "astro check && tsc -p functions/tsconfig.json --noEmit",
    "lint": "eslint .",
    "test:routes": "node scripts/check-routes.mjs",
    "verify": "npm run check && npm run lint && npm run build && npm run test:routes",
    "assets:posters": "node scripts/capture-posters.mjs",
    "assets:og": "node scripts/generate-og.mjs"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.9",
    "@astrojs/sitemap": "^3.7.5",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@lucide/astro": "^1.73.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.12",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@cloudflare/workers-types": "^5.20261114.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@typescript-eslint/parser": "^8.72.2",
    "eslint": "^10.15.0",
    "eslint-plugin-astro": "^3.2.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "wrangler": "^4.162.0"
  }
}
